PORT=5000

MONGO_URI=mongodb+srv://USERNAME:PASSWORD@HOST/DATABASE

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

ADMIN_MAIL=eeduaitor@gmail.com

# Resend (demo booking + notifications)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=EduAItor <noreply@yourdomain.com>


# Allowed browser origins (no trailing slash).
# Include admin dashboard + public website.
CLIENT_URL_1=http://localhost:5173
CLIENT_URL_2=http://localhost:5174
CLIENT_URL_3=https://admin.eduaitor.com
# CLIENT_URL_3=https://www.eduaitor.com

# Admin login (backend only — never put these in frontend .env)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=$2b$12$replace_with_a_bcrypt_hash
JWT_SECRET=replace_with_at_least_32_random_bytes
