PORT=5000

MONGO_URI=mongodb+srv://USERNAME:PASSWORD@HOST/DATABASE

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Support inbox for demo + contact notifications
SUPPORT_MAIL=support@eduaitor.com
ADMIN_MAIL=support@eduaitor.com

# Preferred: eduaitor.com SMTP (GoDaddy / cPanel mailbox)
EMAIL_HOST=mail.eduaitor.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_TLS_REJECT_UNAUTHORIZED=false
EMAIL_USER=support@eduaitor.com
EMAIL_PASS=your-mailbox-password
EMAIL_FROM=Eduaitor <support@eduaitor.com>
# Optional logo override for branded emails
# EMAIL_LOGO_URL=https://www.eduaitor.com/admin/eduaitor.png

# Optional fallback if SMTP unset
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM=Eduaitor <support@eduaitor.com>

# Allowed browser origins (no trailing slash).
CLIENT_URL_1=http://localhost:5173
CLIENT_URL_2=http://localhost:5174
CLIENT_URL_3=https://eduaitor.com
# CLIENT_URL_3=https://www.eduaitor.com

# Admin login (backend only — never put these in frontend .env)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=$2b$12$replace_with_a_bcrypt_hash
JWT_SECRET=replace_with_at_least_32_random_bytes
