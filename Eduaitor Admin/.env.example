# ── Local ──
VITE_API_URL=http://localhost:5000/api

# ── Production (backend on SAME host as admin) ──
# Example: admin at https://admin.eduaitor.com
#          API at   https://admin.eduaitor.com/api
# VITE_API_URL=https://admin.eduaitor.com/api
#
# Or relative (works when admin + API share the same domain):
# VITE_API_URL=/api
