# Copied by Vite per mode:
#   .env.development / .env.production
#
# Default: live website backend on Render.
# For a local API only: VITE_API_URL=http://localhost:5000/api
VITE_API_URL=https://eduaitor-website-backend.onrender.com/api

# Where the navbar "Login" button sends users. The navbar appends /login,
# so point this at the ERP admin root, not the login page itself.
# Falls back to https://eduaitor.com/admin when unset.
VITE_ADMIN_URL=https://eduaitor.com/admin
